# Rendered at container start by the nginx image's envsubst step; only
# variables set in the environment (PORT, API_URL) are substituted, so
# nginx's own $variables are left intact.

server {
    listen ${PORT};
    root /usr/share/nginx/html;

    # Same-origin API: the browser never makes cross-origin calls.
    location /api/ {
        proxy_pass ${API_URL};
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed build assets never change, so cache them for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Single-page app: unknown paths fall back to index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
