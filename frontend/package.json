{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "gen:api": "uv run --project ../backend export-openapi > openapi.json && openapi-typescript openapi.json -o src/api/schema.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "5.105.3",
    "openapi-fetch": "0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vitest": "5.1.0"
  }
}
